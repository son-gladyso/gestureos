{
  "name": "gestureos",
  "private": true,
  "version": "1.0.0",
  "description": "GestureOS hand-tracking VFX demo",
  "scripts": {
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"*.{html,css,js}\"",
    "format:check": "prettier --check \"*.{html,css,js}\"",
    "test": "node tests/run-tests.mjs && node scripts/quality-check.mjs",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "eslint": "^9.20.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3"
  }
}
